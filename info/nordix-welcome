zfs_intro() {
gum_box_sleep "Welcome to the Nordix installer"

gum_box "
#==================================================================================================#
#                    Nordix: Making Enterprise ZFS Accessible to Everyone                          #
#==================================================================================================#

- Simple installer with guided setup
- Carefully configured ZFS setup, tuned for optimal desktop performance
 with selectable profiles for 8GB, 16GB, 32GB, 64GB, and 128GB of RAM.
- Automatic snapshot service from start
- ZFSBootMenu for boot environments and rollbacks
- Advanced vdev options for performance tuning

25 datasets:
- Optimized directorys,
- Optimized ARC caching and snapshot properties
- Optimized recordzice and compression

You don't need to be a ZFS expert to benefit. Nordix does the hard work for you."

# press enter action
    echo ""
    read -r -p "Press Enter to Continue"
    # The start of the installer

clear

gum_box "Nordix uses ZFS as its primary filesystem.
Because the Linux kernel (GPLv2) and OpenZFS (CDDL) have different licenses,
ZFS is not included in the ISO image.
You have the right to build and use ZFS locally.
Nordix respects that this decision is yours, not ours.
To proceed, the installer needs to download, build, and load ZFS (zfs-dkms).
This requires an internet connection and takes a few minutes.
If you choose No, the installation will stop, since Nordix cannot function without ZFS."

if gum_confirm "Do you want to download and build ZFS now?"; then

    clear
    gum_box_sleep "ZFS confirmed. proseeding with downloading of ZFS modules"

else

# confirm if the user not want to download suport for zfs
 if gum_confirm "Do you really want to not install support for ZFS? The system will shutdown if you choose not to."; then
        gum_box_timer "Installation cancelled. Exiting..."
        gum_spin poweroff
else
        # If the user change its mind
        clear
        gum_spin_timer "Phew, that was a close call."
        gum_box_sleep "ZFS confirmed. proceeding with downloading of ZFS modules"
    fi
fi
}
