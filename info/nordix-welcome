#!/bin/bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BACKTITLE="Nordix Installer"

handle_interrupt() {
dialog --clear \
--backtitle "$BACKTITLE" \
--title "Cannot Exit" \
--msgbox "You cant exit here" 5 25
exec "${BASH_SOURCE[0]}" "$@"
}

trap handle_interrupt INT TERM QUIT HUP

